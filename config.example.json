{
  "base_url": "https://token.sensenova.cn/v1",
  "default_model": "deepseek-v4-flash",
  "console_token": "",

  "strategy": "round_robin",
  "max_attempts": 8,
  "timeout": 60,
  "connect_timeout": 10,
  "acquire_timeout": 120,
  "max_total_wait": 120,
  "acquire_fail_fast": 15,
  "retry_backoff": 0.5,
  "max_retry_backoff": 8,
  "min_max_tokens": 2048,
  "track_stream_usage": true,

  "rate_control": {
    "mode": "fixed",
    "qps": 0.2,
    "min_qps": 0.15,
    "max_qps": 1.5,
    "decrease": 0.85,
    "increase_step": 0.05,
    "recovery_seconds": 8
  },
  "max_connections": 64,
  "max_keepalive": 16,

  "cooldown": {
    "base": 60,
    "factor": 1.5,
    "max": 120,
    "jitter": 0.5,
    "invalid_ttl": 600,
    "server_error": 2,
    "model_unavailable": 300
  },

  "flash_lite_exchange": {
    "enabled": false,
    "model": "sensenova-6.8-flash-lite",
    "concurrency": 2,
    "requests_per_trigger": 64,
    "min_interval_s": 300,
    "long_text_max_tokens": 1024,
    "image_enabled": true,
    "image_size": 768,
    "multi_image_count": 3,
    "max_workers": 8
  },

  "auto_renew": {
    "enabled": false,
    "interval_seconds": 180,
    "cleanup_interval_seconds": 1800,
    "key_name": "auto",
    "key_type": "API_KEY_TYPE_TOKEN_PLAN"
  },

  "replenish": {
    "enabled": false,
    "target_count": 0,
    "interval_seconds": 3600,
    "sms_token": "",
    "keyword": "商汤",
    "daily_spend_cap": 5,
    "sms_poll_interval": 5,
    "sms_poll_timeout": 60,
    "key_name": "auto",
    "key_type": "API_KEY_TYPE_TOKEN_PLAN"
  },

  "accounts": [
    {
      "name": "账号1",
      "api_keys": ["${SENSENOVA_KEY_1}"],
      "user": "",
      "phone": "",
      "password": "",
      "rpm_limit": 2,
      "max_concurrency": 4,
      "weight": 1
    },
    {
      "name": "账号2",
      "api_keys": ["${SENSENOVA_KEY_2}"],
      "user": "",
      "phone": "",
      "password": "",
      "rpm_limit": 2,
      "max_concurrency": 4,
      "weight": 1
    },
    {
      "name": "账号3",
      "api_keys": ["${SENSENOVA_KEY_3}"],
      "user": "",
      "phone": "",
      "password": "",
      "rpm_limit": 2,
      "max_concurrency": 4,
      "weight": 1
    }
  ]
}
